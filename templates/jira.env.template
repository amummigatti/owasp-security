# Jira settings for jira-updates-skill.
#
# Copy this file to .env at the repository root and fill in the values:
#     cp templates/jira.env.template .env
#
# .env is git-ignored. Never commit it, and never paste JIRA_API_TOKEN into a
# terminal, a chat, a commit message or an issue - it grants the same access to
# Jira that your account has. If it is ever exposed, revoke it at
# id.atlassian.com/manage-profile/security/api-tokens and issue a new one.
#
# Real environment variables take precedence over this file, so CI can inject
# JIRA_API_TOKEN as a secret without writing it to disk.

# --- required ---

# Your Jira site. A UI URL copied from the browser is fine; the skill reduces it
# to the site origin, so https://your-site.atlassian.net/jira/software/projects/AI
# and https://your-site.atlassian.net both work.
JIRA_BASE_URL=

# The Atlassian account the issues are filed as. Jira Cloud authenticates an API
# token together with the account email, so the token alone is not enough.
JIRA_EMAIL=

# Create at: id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Project key (for example AI) or its numeric id. Both are accepted.
JIRA_PROJECT_ID=

# The issue type to create. It must exist in the project and its create screen
# must include the Labels field, which is how re-runs recognise their own issues.
JIRA_ISSUE_TYPE=Bug

# --- optional ---

# Epic the issues are filed under. A key (AI-1) or a browse URL both work.
# Leave empty to file them at the top level of the project.
JIRA_EPIC_ID=

# Authentication scheme: basic for Jira Cloud (email + API token), bearer for a
# Jira Data Center personal access token (JIRA_EMAIL is then unused).
JIRA_AUTH_TYPE=basic

# Prefix for the labels the skill applies, including the fingerprint label it
# uses for idempotency. Change it only if it collides with your own labels.
JIRA_LABEL_PREFIX=owasp

# Extra labels applied to every issue, comma separated. Useful for a team or
# service tag, for example: team-platform,appsec-2026
JIRA_EXTRA_LABELS=
